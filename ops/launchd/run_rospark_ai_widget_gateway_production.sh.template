#!/bin/bash
set -euo pipefail

export PATH="/opt/homebrew/bin:/usr/bin:/bin"
export PYTHONUNBUFFERED="1"

APP_DIR="@@APP_DIR@@"
cd "$APP_DIR"

exec "/opt/homebrew/bin/python3" \
  "$APP_DIR/scripts/run_ai_widget_pilot_gateway.py" \
  --env-file "$APP_DIR/.env.ai-widget-production.local" \
  --runtime-mode production \
  --host 127.0.0.1 \
  --port 8788 \
  --endpoint http://127.0.0.1:11434 \
  --model qwen3.6:27b \
  --keep-alive 2h
