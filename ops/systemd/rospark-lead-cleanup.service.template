[Unit]
Description=ROSPARK expired lead cleanup
After=local-fs.target
ConditionPathIsDirectory=@@APP_DIR@@
ConditionPathIsDirectory=@@LEAD_DATA_DIR@@

[Service]
Type=oneshot
User=@@APP_USER@@
Group=@@APP_GROUP@@
WorkingDirectory=@@APP_DIR@@
Environment=NODE_ENV=production
UMask=0077
ExecStart=@@FLOCK_BIN@@ -w 30 /run/lock/rospark-lead-registry.lock @@NODE_BIN@@ --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types @@APP_DIR@@/scripts/cleanup_lead_registry.mjs
TimeoutStartSec=90
Nice=10
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=read-only
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadOnlyPaths=@@APP_DIR@@
ReadWritePaths=@@LEAD_DATA_DIR@@ /run/lock
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
