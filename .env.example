NODE_ENV=production
PORT=3000

# Canonical public origin used at build time for links and QR codes.
NEXT_PUBLIC_SITE_URL=https://www.роспарк.рф

# Public Yandex Metrica counter ID. The script loads only after analytics consent.
NEXT_PUBLIC_YANDEX_METRIKA_ID=110980303
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-3Z9KNN3MMK

# Persistent source of truth for site and demo feedback leads.
# Keep both switches false until the L2 release/runbook is explicitly approved.
LEAD_REGISTRY_DB_PATH=/var/lib/rospark-leads/lead-registry.sqlite
LEAD_REGISTRY_ENABLED=false
LEAD_OUTBOX_CHANNELS=max
LEAD_OUTBOX_PROCESSING_ENABLED=false
LEAD_DEFAULT_ASSIGNEE=sergey

# Protected lead registry. Generate hashes with `npm run lead-admin:hash-password`.
LEAD_ADMIN_ENABLED=false
LEAD_ADMIN_SESSION_SECRET=
LEAD_ADMIN_SESSION_TTL_HOURS=8
LEAD_ADMIN_DIRECTOR_USERNAME=andrey
LEAD_ADMIN_DIRECTOR_PASSWORD_HASH=
LEAD_ADMIN_SALES_USERNAME=sergey
LEAD_ADMIN_SALES_PASSWORD_HASH=

# Lead delivery: configure at least one delivery channel.
# Email channel
LEAD_EMAIL_TO=
LEAD_EMAIL_FROM=
LEAD_SMTP_HOST=
LEAD_SMTP_PORT=587
LEAD_SMTP_SECURE=false
LEAD_SMTP_USER=
LEAD_SMTP_PASS=

# Telegram channel
LEAD_TELEGRAM_BOT_TOKEN=
LEAD_TELEGRAM_CHAT_IDS=

# MAX channel for internal lead notifications
LEAD_MAX_BOT_TOKEN=
LEAD_MAX_CHAT_ID=

# Optional public Telegram contact link. Never put secrets in NEXT_PUBLIC_*.
NEXT_PUBLIC_TELEGRAM_CONTACT_URL=

# Optional server-only GREEN-API transport for MAX in the guest-request demo.
# Never expose these values through NEXT_PUBLIC_* variables.
DEMO_MAX_ENABLED=false
GREEN_API_API_URL=
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN_INSTANCE=

# Persistent SQLite file for demo guest requests. Keep it outside the Git checkout on VPS.
DEMO_REQUESTS_DB_PATH=/var/lib/rospark-demo/guest-requests.sqlite

# AI widget. Production is fail-closed: it becomes public only when the log,
# lead registry, live handoff and exact HTTPS gateway are all configured.
AI_WIDGET_ENABLED=false
AI_WIDGET_RUNTIME_MODE=preview
AI_WIDGET_ALLOWED_ORIGINS=
AI_WIDGET_GATEWAY_URL=http://127.0.0.1:8787
AI_WIDGET_GATEWAY_SECRET=
# Read by the Mac Studio gateway process, not by the browser.
AI_WIDGET_GATEWAY_MODE=preview
AI_WIDGET_RATE_LIMIT_SECRET=
AI_WIDGET_HANDOFF_MODE=off
AI_WIDGET_LOGGING_ENABLED=false
AI_WIDGET_LOG_DB_PATH=/var/lib/rospark-ai-widget/dialogs.sqlite

# Legacy preview aliases kept only for backward-compatible Mac Studio builds.
AI_WIDGET_PILOT_ENABLED=false
AI_WIDGET_PILOT_ORIGINS=
